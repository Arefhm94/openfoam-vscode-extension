{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "openfoam",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_item"
      }
    },
    "_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "directive"
        },
        {
          "type": "SYMBOL",
          "name": "block"
        },
        {
          "type": "SYMBOL",
          "name": "entry"
        },
        {
          "type": "SYMBOL",
          "name": "merge_entry"
        },
        {
          "type": "SYMBOL",
          "name": "sized_list"
        }
      ]
    },
    "block": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC_DYNAMIC",
          "value": 1,
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "FIELD",
                "name": "name",
                "content": {
                  "type": "SYMBOL",
                  "name": "_name"
                }
              },
              {
                "type": "STRING",
                "value": "{"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "SYMBOL",
                  "name": "_item"
                }
              },
              {
                "type": "STRING",
                "value": "}"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "STRING",
                    "value": ";"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "{"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_item"
              }
            },
            {
              "type": "STRING",
              "value": "}"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": ";"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          ]
        }
      ]
    },
    "entry": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "_name"
          }
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "value"
            }
          }
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "merge_entry": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "dollar_reference"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "sized_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "count",
          "content": {
            "type": "SYMBOL",
            "name": "number"
          }
        },
        {
          "type": "SYMBOL",
          "name": "list"
        }
      ]
    },
    "_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        }
      ]
    },
    "value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "dollar_reference"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "list"
        },
        {
          "type": "SYMBOL",
          "name": "dimension_set"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "value"
              },
              {
                "type": "SYMBOL",
                "name": "block"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "dimension_set": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "number"
              },
              {
                "type": "SYMBOL",
                "name": "identifier"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "directive": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "include_directive"
        },
        {
          "type": "SYMBOL",
          "name": "input_mode_directive"
        },
        {
          "type": "SYMBOL",
          "name": "conditional_directive"
        },
        {
          "type": "SYMBOL",
          "name": "code_stream_directive"
        },
        {
          "type": "SYMBOL",
          "name": "message_directive"
        },
        {
          "type": "SYMBOL",
          "name": "bare_directive"
        }
      ]
    },
    "include_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "#include"
              },
              {
                "type": "STRING",
                "value": "#includeIfPresent"
              },
              {
                "type": "STRING",
                "value": "#includeEtc"
              },
              {
                "type": "STRING",
                "value": "#includeFunc"
              }
            ]
          }
        },
        {
          "type": "FIELD",
          "name": "path",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          }
        }
      ]
    },
    "input_mode_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#inputMode"
        },
        {
          "type": "FIELD",
          "name": "mode",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        }
      ]
    },
    "conditional_directive": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "STRING",
                    "value": "#if"
                  },
                  {
                    "type": "STRING",
                    "value": "#ifeq"
                  },
                  {
                    "type": "STRING",
                    "value": "#elif"
                  }
                ]
              }
            },
            {
              "type": "FIELD",
              "name": "condition",
              "content": {
                "type": "SYMBOL",
                "name": "value"
              }
            }
          ]
        },
        {
          "type": "STRING",
          "value": "#else"
        },
        {
          "type": "STRING",
          "value": "#endif"
        }
      ]
    },
    "code_stream_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#codeStream"
        },
        {
          "type": "FIELD",
          "name": "body",
          "content": {
            "type": "SYMBOL",
            "name": "block"
          }
        }
      ]
    },
    "message_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "#error"
              },
              {
                "type": "STRING",
                "value": "#warning"
              }
            ]
          }
        },
        {
          "type": "FIELD",
          "name": "message",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          }
        }
      ]
    },
    "bare_directive": {
      "type": "FIELD",
      "name": "name",
      "content": {
        "type": "SYMBOL",
        "name": "directive_name"
      }
    },
    "directive_name": {
      "type": "PATTERN",
      "value": "#[A-Za-z]+"
    },
    "identifier": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_bare_word"
        },
        {
          "type": "SYMBOL",
          "name": "call_key"
        }
      ]
    },
    "_bare_word": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_.:<>+\\-]*"
    },
    "call_key": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_bare_word"
          },
          {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "STRING",
              "value": "("
            }
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_call_arg"
            }
          },
          {
            "type": "STRING",
            "value": ")"
          }
        ]
      }
    },
    "paren_group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_call_arg"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_call_arg": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "call_key"
        },
        {
          "type": "SYMBOL",
          "name": "paren_group"
        },
        {
          "type": "SYMBOL",
          "name": "_bare_word"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "STRING",
          "value": "."
        }
      ]
    },
    "operator": {
      "type": "PATTERN",
      "value": "[*/+\\-|]"
    },
    "number": {
      "type": "PATTERN",
      "value": "-?[0-9]+(\\.[0-9]*)?([eE][+-]?[0-9]+)?"
    },
    "dollar_reference": {
      "type": "PATTERN",
      "value": "\\$\\{?[A-Za-z_][A-Za-z0-9_.:]*\\}?"
    },
    "string": {
      "type": "PATTERN",
      "value": "\"([^\"\\\\]|\\\\.)*\""
    },
    "line_comment": {
      "type": "PATTERN",
      "value": "\\/\\/[^\\n]*"
    },
    "block_comment": {
      "type": "PATTERN",
      "value": "\\/\\*([^*]|\\*+[^*/])*\\*+\\/"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "line_comment"
    },
    {
      "type": "SYMBOL",
      "name": "block_comment"
    }
  ],
  "conflicts": [
    [
      "_name",
      "value"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}