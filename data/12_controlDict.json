{
  "application": {
    "type": "word",
    "required": false,
    "description": "Solver name (classic mechanism; OpenFOAM 9+ modular solvers use 'solver' instead — exactly one of the two is expected, but that either/or constraint isn't expressible in this schema, so neither is marked required)"
  },
  "solver": {
    "type": "word",
    "required": false,
    "description": "Modular solver name (OpenFOAM 9+ alternative to 'application', e.g. incompressibleFluid, incompressibleVoF)"
  },
  "startFrom": {
    "type": "word",
    "required": true,
    "options": [
      "firstTime",
      "startTime",
      "latestTime"
    ]
  },
  "startTime": {
    "type": "scalar",
    "default": 0
  },
  "stopAt": {
    "type": "word",
    "required": true,
    "options": [
      "endTime",
      "noWriteNow",
      "writeNow",
      "nextWrite"
    ]
  },
  "endTime": {
    "type": "scalar",
    "required": true
  },
  "deltaT": {
    "type": "scalar",
    "required": true,
    "description": "Time step"
  },
  "writeControl": {
    "type": "word",
    "required": true,
    "options": [
      "timeStep",
      "runTime",
      "adjustableRunTime",
      "cpuTime",
      "clockTime"
    ]
  },
  "writeInterval": {
    "type": "scalar",
    "required": true
  },
  "purgeWrite": {
    "type": "integer",
    "default": 0,
    "description": "0 = keep all time dirs"
  },
  "writeFormat": {
    "type": "word",
    "default": "ascii",
    "options": [
      "ascii",
      "binary"
    ]
  },
  "writePrecision": {
    "type": "integer",
    "default": 6
  },
  "writeCompression": {
    "default": false,
    "description": "Accepts boolean-style (on/off/true/false/yes/no) or word-style (compressed/uncompressed) values depending on OpenFOAM version"
  },
  "graphFormat": {
    "type": "word",
    "required": false,
    "description": "Output format for function objects that write graph data (e.g. raw, gnuplot, xmgr)"
  },
  "timeFormat": {
    "type": "word",
    "default": "general",
    "options": [
      "fixed",
      "scientific",
      "general"
    ]
  },
  "timePrecision": {
    "type": "integer",
    "default": 6
  },
  "runTimeModifiable": {
    "type": "boolean",
    "default": true
  },
  "adjustTimeStep": {
    "type": "boolean",
    "default": false
  },
  "maxCo": {
    "type": "scalar",
    "required": false,
    "description": "Maximum Courant number"
  },
  "maxAlphaCo": {
    "type": "scalar",
    "required": false,
    "description": "Maximum interface Courant number (VOF/multiphase solvers)"
  },
  "maxDeltaT": {
    "type": "scalar",
    "required": false
  },
  "libs": {
    "type": "list",
    "required": false,
    "description": "Additional shared libraries to load"
  },
  "functions": {
    "type": "dict",
    "required": false,
    "description": "Function objects sub-dictionary"
  }
}