{
  "name": "openfoam-language-support",
  "displayName": "OpenFOAM Dictionary Support",
  "description": "Syntax highlighting and IntelliSense for OpenFOAM dictionary files",
  "version": "0.7.3",
  "publisher": "arefhm94",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arefhm94/openfoam-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "OpenFOAM",
    "CFD",
    "dictionary",
    "foam"
  ],
  "license": "GPL-3.0",
  "icon": "logo.png",
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "openfoam",
        "aliases": [
          "OpenFOAM",
          "openfoam"
        ],
        "extensions": [
          ".foam",
          ".dict"
        ],
        "filenames": [
          "controlDict",
          "fvSchemes",
          "fvSolution",
          "blockMeshDict",
          "snappyHexMeshDict",
          "decomposeParDict",
          "transportProperties",
          "turbulenceProperties",
          "thermophysicalProperties",
          "dynamicMeshDict",
          "topoSetDict",
          "createPatchDict",
          "refineMeshDict",
          "setFieldsDict",
          "helyxHexMeshDict",
          "caseSetupDict",
          "fvOptions",
          "mapFieldsDict",
          "sampleDict",
          "surfaceFeatureExtractDict",
          "materialProperties",
          "RASProperties",
          "regionProperties",
          "phaseProperties",
          "momentumTransport",
          "g",
          "U",
          "p",
          "p_rgh",
          "k",
          "epsilon",
          "omega",
          "nut",
          "nuTilda",
          "alpha",
          "alpha.water",
          "alpha.air",
          "alpha.sludge",
          "T",
          "rho",
          "mu",
          "nu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "openfoam",
        "scopeName": "source.openfoam",
        "path": "./syntaxes/openfoam.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "openfoam",
        "path": "./snippets/openfoam.code-snippets"
      }
    ],
    "semanticTokenTypes": [
      { "id": "geometryFile", "description": "A value that names a geometry file present in constant/triSurface/" },
      { "id": "featureEdge", "description": "A value that names a feature-edge (.eMesh) file" },
      { "id": "caseVariable", "description": "A $reference that resolves to a variable defined in the case" },
      { "id": "boundaryPatch", "description": "A name that matches a patch in constant/polyMesh/boundary" },
      { "id": "includePath", "description": "An #include path that resolves to an existing file" }
    ],
    "semanticTokenScopes": [
      {
        "language": "openfoam",
        "scopes": {
          "geometryFile": ["entity.name.type"],
          "featureEdge": ["entity.name.function"],
          "caseVariable": ["variable"],
          "boundaryPatch": ["entity.name.tag"],
          "includePath": ["string"]
        }
      }
    ],
    "commands": [
      {
        "command": "openfoam.refreshKeywordDB",
        "title": "OpenFOAM: Refresh Keyword Database"
      },
      {
        "command": "openfoam.setLanguageMode",
        "title": "OpenFOAM: Set Language Mode"
      },
      {
        "command": "openfoam.rebuildKeywordDb",
        "title": "OpenFOAM: Rebuild Keyword Database",
        "icon": "$(database)"
      },
      {
        "command": "openfoam.showSchemeDoc",
        "title": "OpenFOAM: Show Scheme Documentation",
        "icon": "$(book)"
      },
      {
        "command": "openfoam.searchInsert",
        "title": "OpenFOAM: Search & Configure (Insert Block)",
        "icon": "$(triangle-down)"
      },
      {
        "command": "openfoam.scaffold.write",
        "title": "OpenFOAM: Write Staged Block",
        "icon": "$(check)"
      },
      {
        "command": "openfoam.scaffold.changeTarget",
        "title": "OpenFOAM: Change Staged Block Target",
        "icon": "$(edit)"
      },
      {
        "command": "openfoam.scaffold.discard",
        "title": "OpenFOAM: Discard Staged Block",
        "icon": "$(trash)"
      },
      {
        "command": "openfoam.insertTurbulenceBlock",
        "title": "OpenFOAM: Insert Turbulence Model Block",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "openfoam.refreshCaseTree",
        "title": "OpenFOAM: Refresh Case Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "openfoam.previewGeometry",
        "title": "OpenFOAM: Preview Geometry (3D)",
        "icon": "$(eye)"
      },
      {
        "command": "openfoam.copyRelativePath",
        "title": "OpenFOAM: Copy Relative Path",
        "icon": "$(copy)"
      },
      {
        "command": "openfoam.revealInFinder",
        "title": "OpenFOAM: Reveal in Finder",
        "icon": "$(link-external)"
      },
      {
        "command": "openfoam.duplicateFile",
        "title": "OpenFOAM: Duplicate File",
        "icon": "$(files)"
      },
      {
        "command": "openfoam.findFileInCase",
        "title": "OpenFOAM: Find File in Case",
        "icon": "$(search)"
      },
      {
        "command": "openfoam.switchCaseRoot",
        "title": "OpenFOAM: Switch Case Root",
        "icon": "$(root-folder)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openfoam-explorer",
          "title": "OpenFOAM",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "openfoam-explorer": [
        {
          "id": "openfoam.caseExplorer",
          "name": "Case Explorer"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        { "command": "openfoam.scaffold.write", "when": "false" },
        { "command": "openfoam.scaffold.changeTarget", "when": "false" },
        { "command": "openfoam.scaffold.discard", "when": "false" }
      ],
      "editor/title": [
        {
          "command": "openfoam.scaffold.write",
          "when": "openfoam.stagingTab",
          "group": "navigation@1"
        },
        {
          "command": "openfoam.scaffold.changeTarget",
          "when": "openfoam.stagingTab",
          "group": "navigation@2"
        },
        {
          "command": "openfoam.scaffold.discard",
          "when": "openfoam.stagingTab",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "openfoam.refreshCaseTree",
          "when": "view == openfoam.caseExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "openfoam.copyRelativePath",
          "when": "view == openfoam.caseExplorer && viewItem != folder",
          "group": "inline@1"
        },
        {
          "command": "openfoam.revealInFinder",
          "when": "view == openfoam.caseExplorer",
          "group": "inline@2"
        },
        {
          "command": "openfoam.duplicateFile",
          "when": "view == openfoam.caseExplorer && viewItem != folder",
          "group": "inline@3"
        }
      ]
    },
    "problemMatchers": [
      {
        "name": "openfoam-fatal",
        "label": "OpenFOAM Fatal Error",
        "fileLocation": "absolute",
        "pattern": [
          {
            "regexp": "^\\s*-->\\s+FOAM (FATAL|WARNING).*$",
            "message": 1
          },
          {
            "regexp": "^\\s*file:\\s+(\\S+)\\s+at line (\\d+)\\.$",
            "file": 1,
            "line": 2
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "openfoam.searchInsert",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorLangId == openfoam"
      }
    ],
    "configuration": {
      "title": "OpenFOAM",
      "properties": {
        "openfoam.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the OpenFOAM language server."
        },
        "openfoam.diagnosticsLevel": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "strict"
          ],
          "default": "standard",
          "description": "Diagnostics verbosity: minimal = errors only, standard = errors + warnings, strict = all checks."
        },
        "openfoam.validateBoundaryPatches": {
          "type": "boolean",
          "default": true,
          "description": "Check field boundary patches against constant/polyMesh/boundary."
        },
        "openfoam.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Auto-format OpenFOAM files on save using the built-in formatter."
        },
        "openfoam.openFOAMSourcePath": {
          "type": "string",
          "default": "",
          "description": "Path to OpenFOAM source tree used when rebuilding the keyword database."
        },
        "openfoam.caseRoot": {
          "type": "string",
          "default": "",
          "description": "Override automatic case root detection. Leave empty to auto-detect."
        },
        "openfoam.scaffold.insertMode": {
          "type": "string",
          "enum": [
            "inline",
            "stagingTab"
          ],
          "enumDescriptions": [
            "Accepting an `@` scaffold suggestion drops the block straight in at the cursor as a snippet (tab through the fields).",
            "Accepting an `@` scaffold suggestion opens the editable staging tab with a Write button instead."
          ],
          "default": "inline",
          "description": "What the `@` Search & Configure suggestions do when accepted."
        },
        "openfoam.docs.onlineHelp": {
          "type": "boolean",
          "default": false,
          "description": "Let the `?` docs lookup and identifier hovers reach cpp.openfoam.org — refreshing the class index and fetching each class's full 'Detailed Description' on demand (cached ~7 days). Off by default: a bundled offline index still provides one-line briefs and links."
        },
        "openfoam.docs.apiVersion": {
          "type": "string",
          "default": "v14",
          "description": "OpenFOAM C++ API docs version for the `?` lookup and hovers (e.g. v14) — the cpp.openfoam.org/<version>/ path segment."
        },
        "openfoam.docs.onAccept": {
          "type": "string",
          "enum": [
            "panel",
            "browser",
            "comment",
            "none"
          ],
          "enumDescriptions": [
            "Open the class documentation in a persistent panel beside the editor.",
            "Open the class page in VS Code's Simple Browser tab.",
            "Insert a // comment with the class brief and page URL.",
            "Do nothing beyond clearing the typed query."
          ],
          "default": "panel",
          "description": "What pressing Enter on a `?` OpenFOAM C++ API suggestion does."
        },
        "openfoam.enableIncludeNavigation": {
          "type": "boolean",
          "default": true,
          "description": "Enable clickable #include links and Ctrl+Click navigation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b && npx esbuild src/webview/geoViewer.ts --bundle --format=iife --outfile=media/geo-viewer.js",
    "watch": "tsc -b -w",
    "pretest": "npm run compile",
    "test": "vitest run",
    "extract-keywords": "node out/extractor/extractKeywords.js",
    "scrape-solvers": "node out/extractor/solverScraper.js",
    "update-database": "npm run scrape-solvers && npm run extract-keywords",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "eslint": "^8.0.0",
    "three": "^0.184.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "tree-sitter-openfoam": "file:vendor/tree-sitter-openfoam",
    "vscode-languageclient": "^8.1.0",
    "vscode-languageserver": "^8.1.0",
    "vscode-languageserver-textdocument": "^1.0.8",
    "web-tree-sitter": "^0.27.0"
  }
}
